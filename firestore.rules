rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid || 
        resource.data.authorId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /notes/{noteId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid
      );
    }

    match /collections/{collectionId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /decks/{deckId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /flashcards/{cardId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /tests/{testId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /attempts/{attemptId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /user_settings/{settingId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == settingId ||
        resource == null ||
        resource.data.ownerId == request.auth.uid
      );
    }

    match /community_notes/{noteId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    match /community_topic_hubs/{hubId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    match /saved_topic_hubs/{savedId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource == null || resource.data.reporterId == request.auth.uid);
    }

    function isUserDocOwner() {
      return isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid
      );
    }

    match /learning_trees/{treeId} {
      allow read, update, delete: if isUserDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /learning_sessions/{sessionId} {
      allow read, update, delete: if isUserDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /saved_learning_resources/{resourceId} {
      allow read, update, delete: if isUserDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /teachback_evaluations/{evalId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /revision_resources/{resourceId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /podcasts/{podcastId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /knowledge_sources/{sourceId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /intake_summaries/{summaryId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
