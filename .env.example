# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Required for the Shorts Learning feature's YouTube video search.
# Create one at https://console.cloud.google.com/apis/credentials with the
# "YouTube Data API v3" enabled. Server-side only, never exposed to the client.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# GOOGLE_SEARCH_API_KEY + GOOGLE_SEARCH_CX: Required for topic reference images (the 3 images
# shown at the end of each generated note topic). Both come from a Google Programmable Search
# Engine (https://programmablesearchengine.google.com/) with "Image search" turned ON and
# "Search the entire web" enabled, plus an API key from
# https://console.cloud.google.com/apis/credentials with the "Custom Search API" enabled.
# Without these, note generation still works — topics simply get no reference images.
GOOGLE_SEARCH_API_KEY="MY_GOOGLE_SEARCH_API_KEY"
GOOGLE_SEARCH_CX="MY_GOOGLE_SEARCH_ENGINE_ID"